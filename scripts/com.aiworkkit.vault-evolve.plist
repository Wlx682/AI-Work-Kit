<?xml version="1.0" encoding="UTF-8"?>
<!--
  AI-Work-Kit Vault 月度进化 · macOS launchd 模板

  安装（手动）：
    cp scripts/com.aiworkkit.vault-evolve.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.aiworkkit.vault-evolve.plist

  卸载：
    launchctl unload ~/Library/LaunchAgents/com.aiworkkit.vault-evolve.plist
    rm ~/Library/LaunchAgents/com.aiworkkit.vault-evolve.plist

  默认：每月 1 号 08:23 跑一次（避开整点）→ Contexts/决策/Vault进化报告-YYYY-MM.md
  日志：/tmp/aiworkkit-vault-evolve.{out,err}.log
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aiworkkit.vault-evolve</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Users/wanglongxiang/Documents/AI-Work-Kit/scripts/vault-evolve.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/wanglongxiang/Documents/AI-Work-Kit</string>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Day</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>8</integer>
    <key>Minute</key>
    <integer>23</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/aiworkkit-vault-evolve.out.log</string>

  <key>StandardErrorPath</key>
  <string>/tmp/aiworkkit-vault-evolve.err.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
