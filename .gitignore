# cc-connect 运行产物（系统提示词快照）
.cc-connect/

# 看板服务运行产物（日志、PID、字节码缓存）
scripts/.kanban-server.log
scripts/.kanban-server.pid
scripts/__pycache__/

# ai-usage-stats 报告产物
ai-usage-report-*.md

# 实验/临时产物（如 figma 验证实验的截图）
tmp/

