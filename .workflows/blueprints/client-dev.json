{
  "name": "client-dev",
  "label": "客户端功能开发",
  "version": "4.2.0",
  "description": "敏捷客户端功能开发：需求分析→需求排序→正式架构→纵向功能故事拆分与故事点→实现落点设计→逐故事 TDD→集成测试计划与审核→全量集成测试。集成通过后直接完成，不包含发布阶段。",
  "usesEpic": true,
  "epicRequired": true,
  "epicTemplate": "Templates/Epic模板-client-dev.md",
  "startup": {
    "createBoard": true,
    "boardSource": "Epic",
    "requireEpicBeforeBoot": true,
    "createEpicSkill": "template-generator",
    "createEpicTemplate": "Templates/Epic模板-client-dev.md",
    "bootCommand": "bash scripts/workflow-board-boot.sh --epic Plans/Epic/xxx.md"
  },
  "bootScript": "scripts/workflow-board-boot.sh",
  "gateScript": "scripts/workflow-gate.sh",
  "enablement": {
    "requires": ["core-tools", "skills", "tool-entrypoints", "global-instructions", "pre-commit-hook", "kanban-board"],
    "preflight": "python3 scripts/workflow-install.py check --workflow client-dev"
  },
  "dedicatedRegression": {
    "command": "python3 scripts/test-client-dev-workflow.py",
    "priority": "P0",
    "scope": "client-dev 敏捷故事流、Story TDD 证据、集成报告和门禁派生行为"
  },
  "triggerHints": [
    "客户端", "功能开发", "功能", "做个功能", "做一个功能", "开发功能",
    "开发一个客户端功能", "客户端项目", "做个客户端项目", "帮我开发", "新需求",
    "从0到1", "完整流程", "走完整流程", "全流程开发", "全流程闭环",
    "启动全流程", "开始做这个项目", "启动项目", "一条龙"
  ],
  "epicMapping": {
    "requirement": "requirement",
    "prioritization": "prioritization",
    "architecture": "architecture",
    "story-split": "development",
    "implementation-design": "development",
    "story-development": "development",
    "integration-test-plan": "integration_plan",
    "integration-test": "integration"
  },
  "stages": [
    {
      "key": "requirement",
      "label": "需求分析（事件风暴 + 实例化需求）",
      "planFolder": "Plans/需求分析",
      "epicField": "requirement",
      "skills": ["event-storming-assistant", "spec-by-example-assistant", "requirement-analyst"],
      "template": "Templates/需求分析-带验收标准模板.md",
      "requiredSections": ["边界情况清单", "异常流程矩阵", "验收标准"],
      "exitCriteria": {
        "childPlanExists": true,
        "status": ["已采纳"],
        "p0Open": 0,
        "sectionsPresent": true,
        "skillRun": true
      },
      "next": "prioritization"
    },
    {
      "key": "prioritization",
      "label": "需求排序与 Backlog 确认",
      "planFolder": "Plans/需求排序",
      "epicField": "prioritization",
      "skills": ["backlog-prioritization-assistant"],
      "template": "Templates/需求排序模板.md",
      "requiredSections": ["排序原则", "需求排序", "团队确认"],
      "exitCriteria": {
        "childPlanExists": true,
        "status": ["已采纳"],
        "sectionsPresent": true,
        "backlogPrioritized": true,
        "skillRunStage": true
      },
      "next": "architecture"
    },
    {
      "key": "architecture",
      "label": "正式架构设计 + ADR",
      "planFolder": "Plans/技术方案",
      "epicField": "architecture",
      "skills": ["architecture-design-assistant"],
      "template": "Templates/技术方案模板.md",
      "requiredSections": ["模块边界", "数据模型", "API Schema", "非功能约束", "ADR", "需求影响矩阵"],
      "exitCriteria": {
        "childPlanExists": true,
        "status": ["已采纳"],
        "sectionsPresent": true,
        "skillRunStage": true
      },
      "next": "story-split"
    },
    {
      "key": "story-split",
      "label": "纵向功能故事拆分 + 故事点 + Scope",
      "planFolder": "Plans/功能开发",
      "epicField": "development",
      "skills": ["task-splitter"],
      "template": "Templates/用户故事拆分模板.md",
      "exitCriteria": {
        "childPlanExists": true,
        "storyScopeReady": true,
        "skillRunStage": true
      },
      "next": "implementation-design"
    },
    {
      "key": "implementation-design",
      "label": "实现落点设计（代码架构/目录/文件名）",
      "planFolder": "Plans/功能开发",
      "epicField": "development",
      "skills": ["implementation-design-assistant"],
      "template": "Templates/客户端功能开发模板.md",
      "requiredSections": ["实现落点设计"],
      "exitCriteria": {
        "childPlanExists": true,
        "sectionsPresent": true,
        "implementationDesignReady": true,
        "skillRunStage": true
      },
      "next": "story-development"
    },
    {
      "key": "story-development",
      "label": "逐用户故事 TDD 开发",
      "planFolder": "Plans/功能开发",
      "epicField": "development",
      "skills": ["feature-dev-assistant", "figma-ui"],
      "template": "Templates/用户故事TDD模板.md",
      "exitCriteria": {
        "childPlanExists": true,
        "storyTddComplete": true,
        "skillRunStage": true
      },
      "next": "integration-test-plan"
    },
    {
      "key": "integration-test-plan",
      "label": "集成测试计划与测试审核",
      "planFolder": "Plans/自动化测试",
      "planSuffix": "集成测试计划",
      "epicField": "integration_plan",
      "skills": ["test-generator"],
      "template": "Templates/集成测试计划模板.md",
      "requiredSections": ["测试策略", "测试用例", "需求与用例覆盖", "测试审核"],
      "exitCriteria": {
        "childPlanExists": true,
        "status": ["已采纳"],
        "sectionsPresent": true,
        "testPlanApproved": true,
        "skillRunStage": true
      },
      "next": "integration-test"
    },
    {
      "key": "integration-test",
      "label": "全量集成测试",
      "planFolder": "Plans/自动化测试",
      "epicField": "integration",
      "skills": ["test-generator"],
      "template": "Templates/集成测试模板.md",
      "exitCriteria": {
        "childPlanExists": true,
        "approvedTestPlan": true,
        "integrationReportPass": true,
        "skillRunStage": true
      },
      "next": "done"
    }
  ],
  "reporting": {
    "format": "📌 当前阶段：[{state}] | 下一个阶段：[{next}] | 看板：http://127.0.0.1:7777/ | 如需中断：/resume plan={planPath}"
  }
}
