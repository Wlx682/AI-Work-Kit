{
  "name": "client-dev",
  "label": "客户端功能开发",
  "version": "2.0.0",
  "description": "客户端功能开发工作流蓝图（15 步进化版）。客户端开发必须先创建 Epic；引擎读本蓝图 stages 驱动阶段推进；门禁只看子 Plan 文件系统事实，不读 Epic lifecycle_state。",
  "usesEpic": true,
  "epicRequired": true,
  "epicTemplate": "Templates/Epic模板-client-dev.md",
  "startup": {
    "createBoard": true,
    "boardSource": "Epic",
    "requireEpicBeforeBoot": true,
    "createEpicSkill": "template-generator",
    "createEpicTemplate": "Templates/Epic模板-client-dev.md",
    "bootCommand": "bash scripts/full-cycle-boot.sh --epic Plans/Epic/xxx.md"
  },
  "bootScript": "scripts/full-cycle-boot.sh",
  "gateScript": "scripts/workflow-gate.sh",
  "constitution": ".workflows/constitution.json",
  "triggerHints": [
    "客户端",
    "功能开发",
    "做个功能",
    "开发功能",
    "开发一个客户端功能",
    "帮我开发",
    "新需求",
    "从0到1",
    "全流程开发",
    "全流程闭环",
    "启动项目",
    "一条龙"
  ],
  "epicMapping": {
    "requirement": "requirement",
    "architecture": "architecture",
    "development": "development",
    "test": "test",
    "verify": "verify",
    "review": "review",
    "deploy": "deploy",
    "retro": "retro"
  },
  "stages": [
    {
      "key": "requirement",
      "label": "需求分析（事件风暴 + 实例化需求）",
      "planFolder": "Plans/需求分析",
      "epicField": "requirement",
      "skills": [
        "event-storming-assistant",
        "spec-by-example-assistant",
        "requirement-analyst"
      ],
      "template": "Templates/需求分析-带验收标准模板.md",
      "wbsSlices": [
        1,
        2
      ],
      "requiredSections": [
        "边界情况清单",
        "异常流程矩阵",
        "验收标准"
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "status": [
          "已采纳"
        ],
        "p0Open": 0,
        "skillRun": true
      },
      "next": "architecture"
    },
    {
      "key": "architecture",
      "label": "技术方案 + ADR",
      "planFolder": "Plans/技术方案",
      "epicField": "architecture",
      "skills": [
        "architecture-design-assistant"
      ],
      "template": "Templates/技术方案模板.md",
      "wbsSlices": [
        3
      ],
      "requiredSections": [
        "模块边界",
        "数据模型",
        "API Schema"
      ],
      "onlyIf": {
        "含业务逻辑": "是"
      },
      "exitCriteria": {
        "childPlanExists": true,
        "status": [
          "已采纳"
        ],
        "skillRun": true
      },
      "next": "test-first"
    },
    {
      "key": "test-first",
      "label": "验收测试先行（外层 TDD）",
      "planFolder": "Plans/自动化测试",
      "epicField": "test",
      "skills": [
        "test-generator"
      ],
      "template": "Templates/自动化测试模板.md",
      "wbsSlices": [
        4
      ],
      "mode": "先行",
      "exitCriteria": {
        "childPlanExists": true,
        "wbsDone": true,
        "testTraceability": true,
        "skillRun": true
      },
      "next": "development"
    },
    {
      "key": "development",
      "label": "功能开发（Domain/Data/UI/交互/单测/联调）",
      "planFolder": "Plans/功能开发",
      "epicField": "development",
      "skills": [
        "task-splitter",
        "feature-dev-assistant",
        "figma-ui"
      ],
      "wbsSlices": [
        5,
        6,
        7,
        8,
        9,
        10
      ],
      "gate": "plan-gate-check",
      "exitCriteria": {
        "childPlanExists": true,
        "planGateCheck": true,
        "wbsDone": true,
        "devTraceability": true,
        "skillRun": true
      },
      "next": "verify"
    },
    {
      "key": "verify",
      "label": "非功能验证（性能/安全/可访问性）",
      "planFolder": "Plans/非功能验证",
      "epicField": "verify",
      "skills": [
        "nfr-assistant"
      ],
      "template": "Templates/非功能验证模板.md",
      "wbsSlices": [
        11
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "wbsDone": true,
        "skillRun": true
      },
      "next": "review"
    },
    {
      "key": "review",
      "label": "Code Review",
      "planFolder": "Plans/代码重构",
      "epicField": "review",
      "skills": [
        "review-assistant"
      ],
      "template": "Templates/Code-Review模板.md",
      "wbsSlices": [
        12
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "wbsDone": true,
        "skillRun": true
      },
      "next": "deploy"
    },
    {
      "key": "deploy",
      "label": "发布检查 + 灰度 + 监控",
      "planFolder": "Plans/部署",
      "epicField": "deploy",
      "skills": [
        "deployment-assistant"
      ],
      "template": "Templates/部署模板.md",
      "wbsSlices": [
        13,
        14
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "wbsDone": true,
        "skillRun": true
      },
      "next": "retro"
    },
    {
      "key": "retro",
      "label": "团队回顾与流程改进",
      "planFolder": "Plans/最佳实践",
      "epicField": "retro",
      "skills": [
        "retro-assistant"
      ],
      "template": "Templates/团队回顾模板.md",
      "wbsSlices": [
        15
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "wbsDone": true,
        "skillRun": true
      },
      "next": "done"
    }
  ],
  "reporting": {
    "format": "📌 当前阶段：[{state}] | 下一个阶段：[{next}] | 看板：http://127.0.0.1:7777/ | 如需中断：/resume plan={planPath}"
  }
}
