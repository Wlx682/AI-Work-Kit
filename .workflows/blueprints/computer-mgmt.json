{
  "name": "computer-mgmt",
  "label": "电脑管理工作流",
  "version": "1.0.0",
  "description": "电脑管理工作流蓝图（无 Epic 轻量清单模式）。证明同一引擎 + 门禁能驱动非客户端、可无 Epic 的流程；门禁只按各 stage planFolder 扫子 Plan 存在性。",
  "usesEpic": false,
  "planRoot": "Plans/电脑管理",
  "bootScript": "scripts/workflow-board-boot.sh",
  "gateScript": "scripts/workflow-gate.sh",
  "enablement": {
    "requires": ["core-tools", "skills", "tool-entrypoints", "global-instructions", "pre-commit-hook", "kanban-board"],
    "preflight": "python3 scripts/workflow-install.py check --workflow computer-mgmt"
  },
  "dedicatedRegression": {
    "command": "python3 scripts/test-workflow-dedicated-regression.py computer-mgmt",
    "priority": "P0",
    "scope": "computer-mgmt 盘点、清理、备份、加固、复核阶段链与 WBS 切片契约"
  },
  "triggerHints": [
    "电脑管理",
    "电脑空间",
    "看一下电脑空间",
    "磁盘空间",
    "空间够不够",
    "空间不够",
    "空间不足",
    "清理电脑",
    "清理一下电脑",
    "清一下电脑",
    "整理电脑",
    "处理电脑",
    "电脑太卡",
    "电脑卡",
    "电脑慢",
    "启动项",
    "缓存",
    "磁盘清理",
    "磁盘满了",
    "释放空间",
    "系统加固",
    "备份电脑",
    "电脑备份",
    "帮我清理"
  ],
  "epicMapping": {},
  "stages": [
    {
      "key": "inventory",
      "label": "盘点（磁盘/应用/启动项/大文件）",
      "planFolder": "Plans/电脑管理",
      "planPrefix": "盘点",
      "skills": [
        "material-prep-assistant"
      ],
      "wbsSlices": [
        1
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "skillRun": true
      },
      "next": "cleanup"
    },
    {
      "key": "cleanup",
      "label": "清理（缓存/临时/无用应用）",
      "planFolder": "Plans/电脑管理",
      "planPrefix": "清理",
      "skills": [
        "material-prep-assistant"
      ],
      "wbsSlices": [
        2
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "skillRun": true
      },
      "next": "backup"
    },
    {
      "key": "backup",
      "label": "备份（关键数据/配置）",
      "planFolder": "Plans/电脑管理",
      "planPrefix": "备份",
      "skills": [
        "material-prep-assistant"
      ],
      "wbsSlices": [
        3
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "skillRun": true
      },
      "next": "harden"
    },
    {
      "key": "harden",
      "label": "加固（安全/权限/更新）",
      "planFolder": "Plans/电脑管理",
      "planPrefix": "加固",
      "skills": [
        "material-prep-assistant"
      ],
      "wbsSlices": [
        4
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "skillRun": true
      },
      "next": "review"
    },
    {
      "key": "review",
      "label": "复核（结果核对 + 归档）",
      "planFolder": "Plans/电脑管理",
      "planPrefix": "复核",
      "skills": [
        "code-review"
      ],
      "wbsSlices": [
        5
      ],
      "exitCriteria": {
        "childPlanExists": true,
        "skillRun": true
      },
      "next": "done"
    }
  ],
  "reporting": {
    "format": "📌 当前阶段：[{state}] | 下一个阶段：[{next}] | 如需中断：/resume plan={planPath}"
  }
}
