{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-work-kit.local/schemas/workflow-blueprint.schema.json",
  "title": "AI-Work-Kit workflow blueprint",
  "type": "object",
  "required": ["name", "label", "version", "usesEpic", "stages"],
  "additionalProperties": true,
  "properties": {
    "kind": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "usesEpic": {
      "type": "boolean"
    },
    "epicTemplate": {
      "type": "string"
    },
    "planRoot": {
      "type": "string"
    },
    "bootScript": {
      "type": "string"
    },
    "gateScript": {
      "type": "string"
    },
    "triggerHints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "epicMapping": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["key", "label", "planFolder", "skills", "exitCriteria", "next"],
        "additionalProperties": true,
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "planFolder": {
            "type": "string",
            "minLength": 1
          },
          "planFolderAlt": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "planPrefix": {
            "type": "string"
          },
          "epicField": {
            "type": "string"
          },
          "skills": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "template": {
            "type": "string"
          },
          "wbsSlices": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            }
          },
          "requiredSections": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "onlyIf": {
            "type": "object"
          },
          "exitCriteria": {
            "type": "object",
            "minProperties": 1
          },
          "next": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reporting": {
      "type": "object"
    }
  }
}
