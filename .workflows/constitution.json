{
  "version": "1.0.0",
  "scope": "client-dev",
  "description": "client-dev 工作流硬规则目录。此文件只索引既有蓝图 / gate / 脚本判定，不作为新的执行门禁。",
  "rules": [
    {
      "id": "tdd_first",
      "rule": "development 前必须完成 test-first 阶段 WBS 4。",
      "severity": "block",
      "checkedBy": "workflow-gate:client-dev.stages[test-first].exitCriteria.wbsDone",
      "source": "Contexts/决策/Kit核心原则.md"
    },
    {
      "id": "skill_run_required",
      "rule": "每个 client-dev 阶段完成时必须有合法 skill_run 反馈块。",
      "severity": "block",
      "checkedBy": "workflow-gate:client-dev.stage.exitCriteria.skillRun",
      "source": "Contexts/决策/Skill反馈协议.md"
    },
    {
      "id": "epic_required",
      "rule": "client-dev 新功能必须存在 Epic，Epic 仅作为数据上下文。",
      "severity": "block",
      "checkedBy": "workflow-gate:usesEpic",
      "source": "Contexts/决策/Kit核心原则.md"
    },
    {
      "id": "traceability",
      "rule": "需求 AC 必须横向追溯到测试用例；P0 AC 必须追溯到功能开发任务。",
      "severity": "block",
      "checkedBy": "workflow-gate:exitCriteria.testTraceability/devTraceability",
      "source": "Contexts/决策/AI-Work-Kit工作流总览.md"
    },
    {
      "id": "figma_forced",
      "rule": "含界面/对稿/还原/Figma 的切片必须走 figma-ui。",
      "severity": "block",
      "checkedBy": "deferred:route-rule-index-only",
      "source": "Contexts/决策/Kit核心原则.md"
    },
    {
      "id": "wbs_single_truth",
      "rule": "子 plan 是 WBS 唯一真理源，Epic 看板只是从子 Plan 事实单向派生的只读投影。",
      "severity": "block",
      "checkedBy": "pre-commit:render-epic-board.py --check",
      "source": "Contexts/决策/母子plan投影规则.md"
    }
  ]
}
